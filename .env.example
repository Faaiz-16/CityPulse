# ---------------------------------------------------------------
# CityPulse configuration. Copy to backend/.env and adjust.
# Every value has a safe default; the app runs with no .env at all.
# ---------------------------------------------------------------

# Database (SQLite by default; any SQLAlchemy URL works, e.g. PostgreSQL)
CITYPULSE_DATABASE_URL=sqlite:///./data/citypulse.db

# Allowed frontend origins (comma-separated)
CITYPULSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# How often the pipeline runs (seconds)
CITYPULSE_TICK_SECONDS=3

# Pull real weather + air quality from Open-Meteo (free, no key).
# false = fully synthetic, deterministic demo (recommended for judging)
CITYPULSE_LIVE_APIS=false

# Optional: AI-assisted summaries. Leave empty to use deterministic templates only.
ANTHROPIC_API_KEY=
CITYPULSE_AI_MODEL=claude-opus-5
CITYPULSE_AI_TIMEOUT_SECONDS=45

# Analysis tuning (see docs/ARCHITECTURE.md for meaning)
CITYPULSE_CURRENT_WINDOW_SECONDS=60
CITYPULSE_ROLLING_WINDOW_MINUTES=10
CITYPULSE_TRAFFIC_THRESHOLD_PCT=30
CITYPULSE_INCIDENT_THRESHOLD_PCT=40
CITYPULSE_INCIDENT_P_VALUE=0.001
CITYPULSE_HEAVY_RAIN_MM_H=7.6
CITYPULSE_AQI_THRESHOLD=150
